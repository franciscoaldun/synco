* CHECO - MODELO DE LA ECONOMIA CHILENA - VERSION 1
NOTE RECONSTRUCCION PEDAGOGICA DEL MODELO DE INFLACION DEL EQUIPO CHECO (CORFO,
NOTE DIAGRAMA DEL 1 DE SEPTIEMBRE DE 1972, ARCHIVO BEER, CAJA 58). LOS NOMBRES
NOTE DE LAS VARIABLES SON LOS DEL ARCHIVO: STB, R22, CP, CPD, R10, FIN, R31, CIR,
NOTE R41, NVP, YNN Y CYT. LAS ECUACIONES ORIGINALES NO SE CONSERVAN COMPLETAS:
NOTE ESTAS SIGUEN LOS PRINCIPIOS DESCRITOS EN EL INFORME DEL EQUIPO.
NOTE UNIDADES: MILLONES DE ESCUDOS DE 1971 (ILUSTRATIVOS). TIEMPO EN ANOS.
NOTE
NOTE ---- BIENES Y SERVICIOS ----
L STB.K=STB.J+(DT)(PRO.JK-R22.JK)            EXISTENCIA DE BIENES Y SERVICIOS
N STB=15000
R PRO.KL=CP.K*PCAP*CYBER/CYBER0              PRODUCCION
C PCAP=0.6                                   PRODUCTO POR ESCUDO DE CAPITAL Y ANO
C CYBER=0.65                                 RENDIMIENTO DE LA INDUSTRIA (CYBERSTRIDE)
C CYBER0=0.65                                RENDIMIENTO DE REFERENCIA
R R22.KL=MIN(DEMR.K,STB.K/TMIN)               TASA DE DEMANDA ATENDIDA
C TMIN=0.1
A DEMR.K=YNN.K*PCON.K/NVP.K                  DEMANDA REAL
A PCON.K=PCON0+STEP(ALZA,0.5)                PROPENSION AL CONSUMO
C PCON0=0.8
C ALZA=0.06                                   REDISTRIBUCION DEL INGRESO (REAJUSTE 1971)
NOTE
NOTE ---- CAPITAL PRODUCTIVO ----
L CP.K=CP.J+(DT)(R10.JK-DEP.JK)              CAPITAL FIJO Y CIRCULANTE EN OPERACION
N CP=100000
R DEP.KL=CP.K/VIDA                           DEPRECIACION
C VIDA=20
L CPD.K=CPD.J+(DT)(INV.JK-R10.JK)            CAPACIDAD OCIOSA (MARGEN DE CRECIMIENTO)
N CPD=10000
R R10.KL=(CPD.K/TINC)*TABHL(TPRE,DEMR.K/PRO.JK,0.6,1.4,0.2)   USO DEL MARGEN
T TPRE=0.4/0.6/1/1.6/2
C TINC=2
NOTE
NOTE ---- FONDOS DE INVERSION Y DINERO ----
L FIN.K=FIN.J+(DT)(R31.JK-INV.JK)            FONDOS DE INVERSION
N FIN=2500
R R31.KL=AHO.K+FALTA.K*EMIS                  CRECIMIENTO DE LOS FONDOS
R INV.KL=MIN(INVD.K,FIN.K/TFIN)              INVERSION EFECTIVA
C TFIN=0.5
A INVD.K=CP.K*(TINV0+STEP(PLAN-TINV0,1))     INVERSION DESEADA
C TINV0=0.05
C PLAN=0.09                                   META DE INVERSION DEL GOBIERNO
A AHO.K=YNN.K*TAHO/NVP.K                     AHORRO REAL
C TAHO=0.0667
A FALTA.K=MAX(0,INVD.K-AHO.K)                FALTA DE FONDOS
C EMIS=1                                      FRACCION CUBIERTA CON EMISION
L CIR.K=CIR.J+(DT)(R41.JK)                   CIRCULANTE
N CIR=18750
R R41.KL=FALTA.K*EMIS*NVP.K                  TASA DE EMISION
A YNN.K=CIR.K/CYT                            INGRESO NOMINAL INTERNO
C CYT=0.25                                   RELACION CIRCULANTE / INGRESO
NOTE
NOTE ---- PRECIOS ----
L NVP.K=NVP.J+(DT)(VPR.JK)                   NIVEL DE PRECIOS (1971 = 1)
N NVP=1
R VPR.KL=NVP.K*(KPRE*EXD.K+KSTB*(1-COB.K))   VARIACION DE PRECIOS
A EXD.K=(DEMR.K-PRO.JK)/PRO.JK               EXCESO DE DEMANDA
A COB.K=STB.K/(PRO.JK*TCOB)                  COBERTURA DE EXISTENCIAS
C KPRE=1.5
C KSTB=0.5
C TCOB=0.25
NOTE
SPEC DT=0.05/LENGTH=10/PRTPER=1/PLTPER=0.25
PLOT STB=S,CP=C,CPD=P,FIN=F/NVP=N/CIR=*
PRINT STB,CP,CPD,FIN,CIR,NVP,YNN,DEMR
