* TALLER - INVENTARIO Y PRODUCCION DE UNA FABRICA
NOTE MODELO DIDACTICO PARA APRENDER DYNAMO (AL ESTILO DE INDUSTRIAL DYNAMICS DE
NOTE FORRESTER, 1961). UNA FABRICA PRODUCE PARA REPONER SU BODEGA; LA DEMANDA SUBE
NOTE UN 20% EN LA SEMANA 5. CAMBIE TAJ (TIEMPO DE AJUSTE) Y DEM (RETARDO DE
NOTE PRODUCCION) Y VEA COMO APARECEN LAS OSCILACIONES.
L INV.K=INV.J+(DT)(PRO.JK-VEN.JK)          INVENTARIO (UNIDADES)
N INV=1000
R VEN.KL=100+STEP(20,5)                    VENTAS POR SEMANA
R PRO.KL=DELAY3(PED.JK,DEM)                 PRODUCCION TERMINADA
R PED.KL=VPRO.K+(INVD-INV.K)/TAJ           ORDENES A PRODUCCION
A VPRO.K=SMOOTH(VEN.JK,4)                  VENTAS PROMEDIO
C INVD=1000                                 INVENTARIO DESEADO
C TAJ=2                                     TIEMPO DE AJUSTE DEL INVENTARIO
C DEM=3                                     DEMORA DE PRODUCCION (SEMANAS)
SPEC DT=0.1/LENGTH=40/PRTPER=2/PLTPER=0.5
PLOT INV=I(600,1400)/VEN=V,PRO=P,PED=O(60,160)
