* FUTURO - MODELO DE LA ECONOMIA (ANDERTON, MARZO 1972)
NOTE RECONSTRUCCION DEL MODELO PRELIMINAR DE RON ANDERTON Y P. WILLIAMS (QUEEN MARY
NOTE COLLEGE, LONDRES), "A PRELIMINARY ACCOUNT OF PRINCIPLES AND OPERATIONS".
NOTE NUEVE NIVELES (L1 A L9) Y LAS TASAS DEL ARCHIVO. LA RESERVA DE DIVISAS L9 PARTE
NOTE EN 1000 (MILLONES DE ESCUDOS), COMO EN LA LINEA 113 DEL CODIGO ORIGINAL.
NOTE PRINCIPIOS: CINCO SECTORES; LA CAPACIDAD DEPENDE DEL CAPITAL; HAY UN RETARDO
NOTE ENTRE INVERTIR Y PRODUCIR; ALIMENTOS Y BIENES DE CONSUMO TIENEN EXISTENCIAS;
NOTE EL INGRESO VIENE DE SALARIOS Y DE RENTAS DEL CAPITAL PRIVADO; SI EL AHORRO Y
NOTE LOS IMPUESTOS NO ALCANZAN HAY DEFICIT; SI SE IMPORTA MAS DE LO QUE SE EXPORTA
NOTE SE AGOTAN LAS RESERVAS.  LAS ECUACIONES SON UNA RECONSTRUCCION.
NOTE
NOTE ---- CAPITAL POR SECTOR (1 INFRAESTRUCTURA, 2 EXPORTACION, 3 BIENES DE CAPITAL,
NOTE      4 BIENES DE CONSUMO, 5 AGRICULTURA) ----
L L1.K=L1.J+(DT)(DELAY3(R11.JK,TCON)-L1.J/VIDA)
N L1=30000
L L2.K=L2.J+(DT)(DELAY3(R21.JK,TCON)-L2.J/VIDA)
N L2=20000
L L3.K=L3.J+(DT)(DELAY3(R31.JK,TCON)-L3.J/VIDA)
N L3=12000
L L4.K=L4.J+(DT)(DELAY3(R41.JK,TCON)-L4.J/VIDA)
N L4=25000
L L5.K=L5.J+(DT)(DELAY3(R51.JK,TCON)-R52.JK)
N L5=13000
R R52.KL=L5.K/VIDA                            DEPRECIACION AGRICOLA
C VIDA=20
C TCON=2                                      RETARDO DE CONSTRUCCION (ANOS)
NOTE
NOTE ---- INVERSION: FONDOS LIMITADOS POR LA CAPACIDAD DE BIENES DE CAPITAL ----
A ITOT.K=MIN(L8.K/TFON,L3.K*0.5+IMPKM)        INVERSION TOTAL POSIBLE
C TFON=0.5
C IMPKM=1000                                  MAXIMO DE BIENES DE CAPITAL IMPORTADOS
R R11.KL=ITOT.K*S1
R R21.KL=ITOT.K*S2
R R31.KL=ITOT.K*S3
R R41.KL=ITOT.K*S4
R R51.KL=ITOT.K*S5
C S1=0.25/S2=0.25/S3=0.2/S4=0.15/S5=0.15     ASIGNACION DE LA INVERSION
NOTE
NOTE ---- PRODUCCION Y EXISTENCIAS ----
R R61.KL=L5.K*0.339                           PRODUCCION AGRICOLA
R R71.KL=L4.K*0.4116                          PRODUCCION DE BIENES DE CONSUMO
L L6.K=L6.J+(DT)(R61.JK+FSUB.JK-R72.JK)       EXISTENCIA DE ALIMENTOS
N L6=2500
L L7.K=L7.J+(DT)(R71.JK-R62.JK)               EXISTENCIA DE BIENES DE CONSUMO
N L7=5500
R R72.KL=MIN(DALI.K,L6.K/TMIN)                CONSUMO DE ALIMENTOS
R R62.KL=MIN(DCON.K,L7.K/TMIN)                CONSUMO DE BIENES DE CONSUMO
C TMIN=0.1
A DALI.K=A01.K*PALI                          DEMANDA DE ALIMENTOS (SALARIOS)
A DCON.K=A01.K*PCONS                         DEMANDA DE BIENES DE CONSUMO
C PALI=0.30/PCONS=0.70
R FSUB.KL=CLIP(MAX(0,DALI.K-R61.JK),0,1,L6.K/(DALI.K*0.25))   ALARMA: IMPORTAR ALIMENTOS
NOTE
NOTE ---- INGRESO ----
A EMPLEO.K=(L1.K+L2.K+L3.K+L4.K+L5.K)*LAB     ANOS-HOMBRE
C LAB=0.006
A A01.K=EMPLEO.K*SAL*(1+STEP(ALZA,0.5))       INGRESO POR SALARIOS
C SAL=24.5                                     SALARIO MEDIO DE 1971
C ALZA=0.3                                     REAJUSTE DE SALARIOS (POLITICA)
A A02.K=(L1.K+L2.K+L3.K+L4.K+L5.K)*PRIV*RENT  RENTAS, INTERESES Y DIVIDENDOS
C PRIV=0.4/RENT=0.1
A AYT.K=A01.K+A02.K                           INGRESO NACIONAL
NOTE
NOTE ---- FONDOS, GOBIERNO Y DEFICIT ----
L L8.K=L8.J+(DT)(AHO.JK+IMP.JK-ITOTR.JK-A82.K)  FONDOS INTERNOS PARA INVERSION
N L8=7000
R AHO.KL=A02.K*0.7+A01.K*0.04                 AHORRO
R IMP.KL=AYT.K*TAX                            IMPUESTOS
C TAX=0.28
R ITOTR.KL=ITOT.K
A A82.K=AYT.K*GOBE                            GASTO DE GOBIERNO
C GOBE=0.10
S DEFIC.K=MAX(0,A82.K+ITOT.K-AHO.JK-IMP.JK)   DEFICIT
NOTE
NOTE ---- COMERCIO EXTERIOR ----
L L9.K=L9.J+(DT)(R91.JK-R92.JK)               RESERVAS DE DIVISAS
N L9=1000
R R91.KL=L2.K*0.141*PCU                       EXPORTACIONES (COBRE)
A PCU.K=1-RAMP(CAIDA,1)                        PRECIO RELATIVO DEL COBRE
C CAIDA=0.05
R R92.KL=ITOT.K*MIMP+FSUB.JK+DCON.K*MCON      IMPORTACIONES
C MIMP=0.25/MCON=0.08
NOTE
SPEC DT=0.05/LENGTH=8/PRTPER=1/PLTPER=0.25
PLOT L9=*(-4000,4000)/AYT=Y,A01=W/L6=A,L7=C/DEFIC=D
PRINT L9,AYT,A01,L6,L7,L8,DEFIC,ITOT
